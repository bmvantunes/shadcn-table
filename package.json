{
  "name": "shadcn-table",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vp test",
    "test:browser": "vp test --project browser --project table-browser --run",
    "test:browser:performance": "vp run @bruno/table#test:browser:performance",
    "test:skills": "vp run @bruno/table#test:skills",
    "check": "vp check",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@bruno/table": "workspace:*",
    "@tanstack/intent": "^0.3.8",
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "oxc-transform-react": "^0.145.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "intent": {
    "skills": [
      "workspace:@bruno/table",
      "@tanstack/react-table",
      "@tanstack/table-core"
    ],
    "exclude": [
      "@tanstack/table-core#pagination",
      "@tanstack/table-core#row-pinning"
    ]
  }
}
