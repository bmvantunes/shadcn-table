{
  "name": "@bruno/table",
  "version": "0.0.0",
  "description": "A high-performance, strongly typed data grid for React.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./effect": {
      "types": "./dist/effect.d.mts",
      "import": "./dist/effect.mjs",
      "default": "./dist/effect.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "check:build": "node scripts/assert-build-output.mjs",
    "dev": "vp pack --watch",
    "test": "vp test --exclude \"src/**/*.browser.test.tsx\"",
    "test:browser": "vp test --config vitest.browser.config.ts --run",
    "test:browser:emitted": "vp test --config vitest.emitted-browser.config.ts --run",
    "test:bench:hotkeys": "vp test bench src/internal/hotkey-adapter.bench.ts --run",
    "test:bench:hotkeys:browser": "vp test bench --config vitest.browser.config.ts src/internal/hotkey-adapter.browser.bench.tsx --run",
    "test:bench:column-management": "vp test bench src/internal/column-management.bench.ts --run",
    "test:bench:toolbar": "vp test bench src/internal/toolbar-capabilities.bench.ts --run",
    "test:bench:row-selection": "vp test bench src/internal/row-selection.bench.ts --run",
    "test:bench:cell-range": "vp test bench src/internal/cell-range-clipboard.bench.ts --run",
    "test:bench:client-grouping": "vp test bench src/internal/client-grouping.bench.ts --run",
    "test:bench:server-viewport": "vp test bench src/internal/server-viewport-store.bench.ts --run",
    "test:types:source": "tsc --project tsconfig.type-tests.json",
    "test:types:emitted": "tsc --project tests/emitted-consumer/tsconfig.emitted.json && tsc --project tests/emitted-consumer/tsconfig.emitted-server.json && tsc --project tests/emitted-effect-consumer/tsconfig.emitted.json",
    "prepublishOnly": "vp run @bruno/shadcn#build && vp run check && vp run test && vp run test:browser && vp run test:types:source && vp run build && vp run test:browser:emitted && vp run check:build && vp run test:types:emitted && vp run test:bench:hotkeys && vp run test:bench:hotkeys:browser && vp run test:bench:column-management && vp run test:bench:toolbar && vp run test:bench:row-selection && vp run test:bench:cell-range && vp run test:bench:client-grouping && vp run test:bench:server-viewport"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-hotkeys": "0.10.0",
    "@tanstack/react-pacer": "0.23.0",
    "@tanstack/react-table": "9.0.0",
    "@tanstack/store": "0.11.1",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@bruno/shadcn": "workspace:*",
    "@effect/atom-react": "4.0.0-rc.111",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "4.1.10",
    "effect": "4.0.0-rc.111",
    "effect-view-server": "4.2.7",
    "oxc-transform-react": "^0.145.0",
    "playwright": "1.60.0",
    "react": "^19.2.8",
    "react-dom": "19.2.8",
    "redis": "6.2.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "^4.1.10",
    "vitest-browser-react": "2.2.0"
  },
  "peerDependencies": {
    "@bruno/shadcn": ">=0.0.0 <1.0.0",
    "effect": "4.0.0-rc.111",
    "react": "^19.2.8"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "inlinedDependencies": {
    "effect-view-server": "4.2.7"
  }
}
